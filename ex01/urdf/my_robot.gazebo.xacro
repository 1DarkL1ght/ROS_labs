<?xml version="1.0"?>
<robot name="differential_robot_8w"
  xmlns:xacro="http://ros.org/wiki/xacro">
    <!-- Materials -->
  <material name="DarkGreen">
    <color rgba="0.0 0.3 0.0 1.0"/>
  </material>
  <material name="Black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
  <!-- Robot constants -->
  <xacro:property name="base_width" value="0.31"/>
  <xacro:property name="base_length" value="0.8"/>
  <xacro:property name="base_height" value="0.18"/>
  <xacro:property name="wheel_radius" value="0.06"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_ygap" value="0.025"/>
  <xacro:property name="wheel_zoff" value="0.1"/>
  <xacro:property name="wheel_xoff" value="0.12"/>
  <xacro:property name="caster_xoff" value="0.14"/>
  <!-- Macros for inertial properties -->
  <xacro:macro name="box_inertia" params="m w h d">
    <inertial>
      <origin xyz="0 0 0" rpy="${pi/2} 0 ${pi/2}"/>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (h*h + d*d)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12) * (w*w + d*d)}" iyz="0.0" izz="${(m/12) * (w*w + h*h)}"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0" ixz="0"
               iyy="${(m/12) * (3*r*r + h*h)}" iyz="0" izz="${(m/2) * r*r}"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(2/5)*m*r*r}" ixy="0" ixz="0"
               iyy="${(2/5)*m*r*r}" iyz="0" izz="${(2/5)*m*r*r}"/>
    </inertial>
  </xacro:macro>
  <!-- Robot Base -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="DarkGreen"/>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
  </link>
  <link name="base_footprint">
    <xacro:box_inertia m="15" w="${base_width}" d="${base_length}" h="${base_height}"/>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 ${-(wheel_radius+wheel_zoff)}" rpy="0 0 0"/>
  </joint>
  <!-- Wheels macro -->
  <xacro:macro name="wheel" params="prefix x_pos y_pos">
    <link name="${prefix}_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="Black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="0.5" r="${wheel_radius}" h="${wheel_width}"/>
    </link>
    <joint name="${prefix}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_link"/>
      <origin xyz="${x_pos} ${y_pos} ${-wheel_zoff}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <!-- 8 wheels, 4 per side -->
  <xacro:wheel prefix="wheel_l1" x_pos="-0.32" y_pos="0.15"/>
  <xacro:wheel prefix="wheel_l2" x_pos="-0.12" y_pos="0.15"/>
  <xacro:wheel prefix="wheel_l3" x_pos="0.12" y_pos="0.15"/>
  <xacro:wheel prefix="wheel_l4" x_pos="0.32" y_pos="0.15"/>
  <xacro:wheel prefix="wheel_r1" x_pos="-0.32" y_pos="-0.15"/>
  <xacro:wheel prefix="wheel_r2" x_pos="-0.12" y_pos="-0.15"/>
  <xacro:wheel prefix="wheel_r3" x_pos="0.12" y_pos="-0.15"/>
  <xacro:wheel prefix="wheel_r4" x_pos="0.32" y_pos="-0.15"/>
  <!-- Low cylinder on top -->
  <link name="top_cylinder">
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.15"/>
      </geometry>
      <material name="DarkGreen"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.1" length="0.15"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="2" r="0.1" h="0.15"/>
  </link>
  <joint name="top_cylinder_joint" type="continuous">
    <parent link="base_link"/>
    <child link="top_cylinder"/>
    <origin xyz="0.15 0 ${base_height/2 + 0.025}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="5.0" velocity="2.0"/>
  </joint>
  <!-- Thin long cylinder sticking out -->
  <link name="antenna">
    <visual>
      <origin xyz="0.25 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.5"/>
      </geometry>
      <material name="Black"/>
    </visual>
    <collision>
      <origin xyz="0.25 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.5"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.1" r="0.01" h="0.5"/>
  </link>
  <joint name="antenna_joint" type="fixed">
    <parent link="top_cylinder"/>
    <child link="antenna"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
  </joint>
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.05"/>
      </geometry>
      <material name="Black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.05"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.3" r="0.03" h="0.05"/>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="top_cylinder"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>
  <!-- Gazebo Differential Drive plugin -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_l2_joint</left_joint>
      <right_joint>wheel_r2_joint</right_joint>
      <wheel_separation>${base_width + 2*wheel_ygap}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
          name="gz::sim::systems::JointPositionController">
      <joint_name>top_cylinder_joint</joint_name>
      <topic>turret_position</topic>
    </plugin>
  <plugin filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
    <topic>joint_states</topic>
    <joint_name>wheel_l1_joint</joint_name>
    <joint_name>wheel_r1_joint</joint_name>
    <joint_name>wheel_l2_joint</joint_name>
    <joint_name>wheel_r2_joint</joint_name>
    <joint_name>wheel_l3_joint</joint_name>
    <joint_name>wheel_r3_joint</joint_name>
    <joint_name>wheel_l4_joint</joint_name>
    <joint_name>wheel_r4_joint</joint_name>
    <joint_name>top_cylinder_joint</joint_name>
  </plugin>
  </gazebo>
  <gazebo reference="wheel_l1_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>
  <gazebo reference="wheel_l3_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>
  <gazebo reference="wheel_l4_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>
  <gazebo reference="wheel_r1_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>
  <gazebo reference="wheel_r3_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>
  <gazebo reference="wheel_r4_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <ray> 
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          
          <min>0.1</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
    </sensor>
  </gazebo>
  <gazebo reference="lidar_link">
    <sensor name="depth_camera" type="depth_camera">
      <update_rate>6</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <topic>/depth_camera/image</topic>

      <pose>0.1 0 0.4 0 0 0</pose>

      <camera>
        <horizontal_fov>1.51843645</horizontal_fov>
        <image>
          <width>848</width>
          <height>480</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10</far>
        </clip>
        <lens>
          <intrinsics>
            <fx>421.61578369140625</fx>
            <fy>421.61578369140625</fy>
            <cx>422.2854309082031</cx>
            <cy>236.57237243652344</cy>
            <s>0</s>
          </intrinsics>
        </lens>
      </camera>
    </sensor>
  </gazebo>
</robot>